{
  "name": "linkforge",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "pnpm --filter api start:dev",
    "dev:web": "pnpm --filter web dev",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  }
}
